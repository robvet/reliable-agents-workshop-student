# LMs
MCP_OPENAI_ENDPOINT="<endpoint>"
AZURE_OPENAI_ENDPOINT="<endpoint>"            

INTENT_SML_DEPLOYMENT=gpt-5.4-mini
INFERENCE_LM_DEPLOYMENT=gpt-5.6-sol

# Datastore
DATABASE_URL="<endpoint>"

# Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING="<instrumentation_key>"

# mcp endpoint
MCP_SERVER_URL="<endpoint>"

# App environment label
APP_ENVIRONMENT=dev

# Show the real exception text in an error response instead of a generic message.
# Useful while working through the labs; leave False outside local development.
SHOW_VERBOSE_ERRORS=False

# Agent Timeout (seconds) — total request timeout for all model API calls
# default total timeout for all model calls (can be overridden by per-model timeouts below)
AGENT_TIMEOUT=300.0
AGENT_CONNECT_TIMEOUT=30.0
AGENT_TIMEOUT_GPT=300.0

# Flag to show/hide the Swagger browser window in the FastAPI app (default: False)
OPEN_SWAGGER_BROWSER=False
#False/True
