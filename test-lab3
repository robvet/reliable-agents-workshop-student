#!/bin/bash

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEST_TARGET="$REPO_ROOT/tests/test_lab3_reliable_orchestration.py"

if [[ "${1:-}" == ::* ]]; then
    TEST_TARGET+="$1"
    shift
fi

PYTHONPATH="$REPO_ROOT/src" exec "$REPO_ROOT/.venv/bin/python" -m pytest "$TEST_TARGET" -v -s -p no:warnings "$@"
