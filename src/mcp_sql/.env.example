# Copy to .env and fill in real values. Never commit the populated file.

# Single source of truth for the Postgres connection. Parsed and passed to
# the pgEdge subprocess via PGEDGE_DB_* env vars — never duplicated.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require

# Azure AI Foundry endpoint + deployment for the single nl2sql LLM call.
# Auth is via DefaultAzureCredential (AAD) — same pattern as src/app's
# AzureIdentityProvider. No API key.
MCP_OPENAI_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/...
INFERENCE_LM_DEPLOYMENT=<deployment-name>

# Optional. If unset, the server still runs and logs to stdout.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Result cap applied to every run_sql/ask call. Defaults to 100.
MAX_ROWS=100

# Path to the pgedge-postgres-mcp binary (defaults to ./pgedge-postgres-mcp).
PGEDGE_BIN=./pgedge-postgres-mcp

# Only needed if PGEDGE_* env vars don't work for the connection.
PGEDGE_CONFIG=
